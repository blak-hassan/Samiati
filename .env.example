# ---------------------------------------------------------------------------
# Samiati — environment variables
#
# Copy this file to `.env.local` and fill in what you need.
#
# NOTHING HERE IS REQUIRED. With no configuration at all, Samiati runs in
# local mode with the clearly-labelled placeholder providers: conversations
# and contributions are stored in your browser, and the assistant explains
# that no model is connected.
#
# Never commit a filled-in copy of this file. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Reasoning model
#
# Any OpenAI-compatible chat-completions endpoint works: OpenAI, OpenRouter,
# Groq, Together, a self-hosted vLLM, or an Ollama server on your LAN.
#
# Cost: roughly USD 0.0002–0.0005 per turn with gpt-4o-mini.
# ---------------------------------------------------------------------------

# The API key. If unset, Samiati uses the placeholder reasoner.
SAMIATI_REASONING_API_KEY=

# The base URL of the endpoint. Defaults to https://api.openai.com/v1
# Examples:
#   https://openrouter.ai/api/v1
#   https://api.groq.com/openai/v1
#   https://your-vllm-host.internal/v1
SAMIATI_REASONING_BASE_URL=

# The model id. Defaults to gpt-4o-mini.
SAMIATI_REASONING_MODEL=

# ---------------------------------------------------------------------------
# Translation model
#
# Uses the Hugging Face inference API with Meta's NLLB-200 family, which
# covers 200 languages including all of Samiati's targets.
#
# Cost: the free tier covers occasional use. For production, a dedicated
# NLLB deployment is a few hundred USD per month for the whole user base.
# ---------------------------------------------------------------------------

# If unset, Samiati uses the placeholder translator and says so.
HUGGINGFACE_API_KEY=

# The model id. Defaults to facebook/nllb-200-distilled-600M
# SAMIATI_TRANSLATION_MODEL=facebook/nllb-200-distilled-600M

# A dedicated model for one language. The router prefers it over the general
# model for that language. The name after the prefix is the Samiati language
# id, in upper case: KISWAHILI, SHENG, KIKUYU, ...
# SAMIATI_TRANSLATION_MODEL_KISWAHILI=


# ---------------------------------------------------------------------------
# Persistence
#
# If NEXT_PUBLIC_CONVEX_URL is unset, Samiati stores everything in
# `localStorage` on the device. Set it to switch to Convex.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CONVEX_URL=
# NEXT_PUBLIC_CLERK_FRONTEND_API_URL=

# ---------------------------------------------------------------------------
# Accounts
#
# If unset, Samiati runs in guest mode with a local identity. Set it to
# require accounts through Clerk.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
